<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:text="Nueva idea"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_new_text"
            style="@style/QuickButton"
            android:text="📝\nEscribir" />

        <Button
            android:id="@+id/btn_new_audio"
            style="@style/QuickButton"
            android:text="🎤\nAudio" />

        <Button
            android:id="@+id/btn_new_photo"
            style="@style/QuickButton"
            android:text="📷\nFoto" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_new_video"
            style="@style/QuickButton"
            android:text="🎬\nVídeo" />

        <Button
            android:id="@+id/btn_search"
            style="@style/QuickButton"
            android:text="🔍\nBuscar" />

        <Button
            android:id="@+id/btn_categories"
            style="@style/QuickButton"
            android:text="🗂\nCategorías" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:text="Últimas ideas (mantén pulsada una para mover o eliminar)"
        android:textAppearance="?attr/textAppearanceSubtitle1" />

    <ListView
        android:id="@+id/list_recent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:text="Todavía no has guardado nada.\nPulsa Escribir, Audio o Foto para empezar."
        android:visibility="gone" />
</LinearLayout>
